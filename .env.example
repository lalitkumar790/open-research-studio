# Neon PostgreSQL pooled connection (server only)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Neon Managed Auth values for the same Neon branch
NEON_AUTH_BASE_URL="https://YOUR-NEON-AUTH-ENDPOINT/neondb/auth"
NEON_AUTH_JWKS_URL="https://YOUR-NEON-AUTH-ENDPOINT/neondb/auth/.well-known/jwks.json"
NEXT_PUBLIC_NEON_AUTH_URL="https://YOUR-NEON-AUTH-ENDPOINT/neondb/auth"

# Neon private Object Storage S3-compatible credentials (server only)
AWS_ACCESS_KEY_ID="..."
AWS_SECRET_ACCESS_KEY="..."
AWS_ENDPOINT_URL_S3="https://YOUR-NEON-OBJECT-STORAGE-ENDPOINT"
AWS_REGION="ap-southeast-1"
NEON_STORAGE_BUCKET="uploads"
